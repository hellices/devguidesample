    {
      "id": "approximated-lru-text-31",
      "type": "text",
      "x": 0,
      "y": 420,
      "width": 659.12,
      "height": 52.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
