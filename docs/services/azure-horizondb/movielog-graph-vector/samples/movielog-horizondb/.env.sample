# Copy to .env (never commit .env) and fill in real values.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/springsample
SPRING_DATASOURCE_USERNAME=springsample
SPRING_DATASOURCE_PASSWORD=change-me

# https://www.themoviedb.org/settings/api : the "API Key" or the "API Read Access Token"
TMDB_API_KEY=
# https://www.omdbapi.com/apikey.aspx : free key (1,000 requests/day), used for Rotten Tomatoes scores
OMDB_API_KEY=

# Azure OpenAI endpoint for semantic search (Entra ID via Azure CLI login locally; no key)
AZURE_OPENAI_ENDPOINT=

# Optional Microsoft Entra ID sign-in: add the entra profile (SPRING_PROFILES_ACTIVE=dev,entra) and register
# http://localhost:8080/login/oauth2/code/entra as a redirect URI of a single-tenant app registration.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
