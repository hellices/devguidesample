  {
   "id": 10,
   "type": "timeseries",
   "title": "HorizonDB SQL 호출 수와 평균 시간",
   "description": "type=postgresql dependency. 왼쪽 축 분당 호출, 오른쪽 축 평균 ms.",
   "datasource": {
    "type": "grafana-azure-monitor-datasource",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-azure-monitor-datasource",
      "uid": "${datasource}"
     },
     "queryType": "Azure Log Analytics",
     "azureLogAnalytics": {
      "query": "dependencies\n| where $__timeFilter(timestamp)\n| where cloud_RoleName == ${role:singlequote}\n| where type == \"postgresql\"\n| summarize calls = count(), avg_ms = avg(duration) by bin(timestamp, max_of($__interval, 1m))\n| order by timestamp asc",
      "resources": [
       "$appinsights"
      ],
