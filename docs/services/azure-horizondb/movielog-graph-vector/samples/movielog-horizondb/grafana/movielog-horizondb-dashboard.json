     "azureLogAnalytics": {
      "query": "customMetrics\n| where $__timeFilter(timestamp)\n| where cloud_RoleName == ${role:singlequote}\n| where name == \"movielog_discover_search\"\n| summarize calls = sum(valueCount) by bin(timestamp, max_of($__interval, 1m))\n| order by timestamp asc",
