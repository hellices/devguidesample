{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "operatorObjectId": { "value": "${MCP_OPERATOR_ID}" },
    "expiresOn": { "value": "${MCP_EXPIRES_ON}" },
    "customApiClientId": { "value": "${MCP_CUSTOM_API_CLIENT_ID}" },
    "customApiClientSecret": { "value": "${MCP_CUSTOM_API_CLIENT_SECRET}" },
    "azureApiClientId": { "value": "${MCP_AZURE_API_CLIENT_ID}" },
    "publicClientId": { "value": "${MCP_PUBLIC_CLIENT_ID}" },
    "pythonImage": { "value": "${SERVICE_MCP_IMAGE_NAME}" }
  }
}
