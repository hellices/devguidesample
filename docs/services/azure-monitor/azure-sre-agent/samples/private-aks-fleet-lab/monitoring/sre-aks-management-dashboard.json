            "query": "resources\n| where type =~ \"microsoft.containerservice/managedclusters\"\n| extend K8sVersion = tostring(properties.currentKubernetesVersion),\n         SupportPlan = coalesce(tostring(tags['SupportPlan']), tostring(properties.supportPlan), 'KubernetesOfficial'),\n         mgmtName = coalesce(tostring(tags['mgmtName']), 'ENT_Workloads_Prod')\n| where SupportPlan =~ 'KubernetesOfficial'\n| summarize Total=count(),\n            Prd=countif(mgmtName contains 'Prod' and not(mgmtName contains 'NonProd')),\n            Dev=countif(mgmtName contains 'NonProd'),\n            Stg=countif(mgmtName contains 'Stg'),\n            Shared=countif(mgmtName contains 'Shared')\n            by K8sVersion, SupportPlan\n| order by K8sVersion asc",
            "scope": "directory"
