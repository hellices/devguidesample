    {
      "id": 1,
      "title": "관리 대상 — Management Group 기준 관리대상 클러스터 분류",
      "description": "*제외대상 구독 네이밍 참고: 샌드박스(sbox), PoC(poc), RnD(rnd), SRE(sre)",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 5,
        "h": 15
      },
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${am_ds}"
      },
      "targets": [
        {
          "azureMonitor": {
            "allowedTimeGrainsMs": [],
            "timeGrain": "auto"
          },
          "azureResourceGraph": {
            "query": "resources\n| where type =~ \"microsoft.containerservice/managedclusters\"\n| extend mgmtName = coalesce(tostring(tags['mgmtName']), 'ENT_Workloads_Prod')\n| extend envType = case(mgmtName contains 'NonProd', '개발', mgmtName contains 'Stg', '스테이지', mgmtName contains 'Shared', '쉐어드인프라', '운영')\n| summarize ['클러스터수']=count() by ['관리그룹']=mgmtName, ['환경분류']=envType\n| extend ['관리여부']='O'\n| project ['관리그룹'], ['환경분류'], ['관리여부'], ['클러스터수']\n| order by ['관리그룹'] asc",
            "scope": "directory"
          },
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${am_ds}"
          },
          "queryType": "Azure Resource Graph",
          "refId": "A",
          "subscriptions": []
        }
      ]
    },
