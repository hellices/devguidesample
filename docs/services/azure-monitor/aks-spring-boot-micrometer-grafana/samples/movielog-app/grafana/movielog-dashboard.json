            "uid": "${datasource}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "customMetrics\n| where $__timeFilter(timestamp)\n| where cloud_RoleName == \"$role\"\n| where name == \"movielog_review_rating\"\n| where timestamp < bin(now(), max_of($__interval, 1m))\n| summarize stars = sum(valueSum) / sum(valueCount) by bin(timestamp, max_of($__interval, 1m))\n| order by timestamp asc",
            "resources": [
              "$appinsights"
            ],
            "resultFormat": "time_series"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "min": 0,
          "max": 5,
          "displayName": "평균 별점",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 2.5
              },
              {
                "color": "green",
                "value": 3.5
              }
            ]
          },
          "custom": {
            "lineWidth": 2,
            "thresholdsStyle": {
              "mode": "area"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "type": "row",
      "title": "누적 현황 (Gauge: DB 기준이라 Pod 간 max)",
      "collapsed": false,
      "gridPos": {
