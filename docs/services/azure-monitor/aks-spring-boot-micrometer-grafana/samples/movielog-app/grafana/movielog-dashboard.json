    {
      "id": 12,
      "type": "stat",
      "title": "카탈로그 영화",
      "description": "movielog_movies_stored. 모든 Pod가 같은 DB 값을 보고하므로 bin마다 max(value)를 씁니다. sum을 쓰면 Pod 수배로 부풀려집니다.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 27
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${datasource}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "customMetrics\n| where $__timeFilter(timestamp)\n| where cloud_RoleName == \"$role\"\n| where name == \"movielog_movies_stored\"\n| where timestamp < bin(now(), max_of($__interval, 1m))\n| summarize stored = max(value) by bin(timestamp, max_of($__interval, 1m))\n| order by timestamp asc",
            "resources": [
              "$appinsights"
            ],
            "resultFormat": "time_series"
          }
        }
