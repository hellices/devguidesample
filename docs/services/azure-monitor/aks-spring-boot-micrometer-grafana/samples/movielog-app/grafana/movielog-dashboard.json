{
  "title": "MovieLog 비즈니스 지표 (Micrometer → Application Insights)",
  "uid": "movielog-business-metrics",
  "tags": [
    "spring-boot",
    "micrometer",
    "application-insights",
    "movielog"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Azure Monitor",
        "type": "datasource",
        "query": "grafana-azure-monitor-datasource",
        "current": {},
        "hide": 0
      },
      {
        "name": "appinsights",
        "label": "Application Insights resource ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      },
      {
        "name": "role",
        "label": "cloud_RoleName",
        "type": "textbox",
        "query": "movielog",
        "current": {
          "text": "movielog",
          "value": "movielog"
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "핵심 지표 (선택 구간 합계와 평균)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "영화 조회",
      "description": "movielog_movie_views 증가량 합계. 웹 상세 화면과 API 조회를 모두 셉니다. 배경 곡선은 같은 값의 bin별 추이입니다.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${datasource}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "customMetrics\n| where $__timeFilter(timestamp)\n| where cloud_RoleName == \"$role\"\n| where name == \"movielog_movie_views\"\n| where timestamp < bin(now(), max_of($__interval, 1m))\n| summarize total = sum(value) by bin(timestamp, max_of($__interval, 1m))\n| order by timestamp asc",
            "resources": [
              "$appinsights"
            ],
            "resultFormat": "time_series"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "새 리뷰",
      "description": "movielog_reviews_posted 증가량 합계. 커밋된 리뷰만 집계됩니다. 배경 곡선은 같은 값의 bin별 추이입니다.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 5,
        "x": 5,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${datasource}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "customMetrics\n| where $__timeFilter(timestamp)\n| where cloud_RoleName == \"$role\"\n| where name == \"movielog_reviews_posted\"\n| where timestamp < bin(now(), max_of($__interval, 1m))\n| summarize total = sum(value) by bin(timestamp, max_of($__interval, 1m))\n| order by timestamp asc",
            "resources": [
              "$appinsights"
            ],
            "resultFormat": "time_series"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "신규 회원",
      "description": "movielog_members_signups 증가량 합계. 배경 곡선은 같은 값의 bin별 추이입니다.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 5,
        "x": 10,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${datasource}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "customMetrics\n| where $__timeFilter(timestamp)\n| where cloud_RoleName == \"$role\"\n| where name == \"movielog_members_signups\"\n| where timestamp < bin(now(), max_of($__interval, 1m))\n| summarize total = sum(value) by bin(timestamp, max_of($__interval, 1m))\n| order by timestamp asc",
            "resources": [
              "$appinsights"
            ],
            "resultFormat": "time_series"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 5,
      "type": "gauge",
      "title": "평균 별점",
      "description": "DistributionSummary라 sum(valueSum) / sum(valueCount)로 계산합니다. fresh 기준인 3.5개부터 초록색입니다.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 15,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${datasource}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "customMetrics\n| where $__timeFilter(timestamp)\n| where cloud_RoleName == \"$role\"\n| where name == \"movielog_review_rating\"\n| where timestamp < bin(now(), max_of($__interval, 1m))\n| summarize stars = sum(valueSum) / sum(valueCount)",
            "resources": [
              "$appinsights"
            ],
            "resultFormat": "table"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "min": 0,
          "max": 5,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 2.5
              },
              {
                "color": "green",
                "value": 3.5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdMarkers": true,
        "showThresholdLabels": false,
        "orientation": "auto"
      }
    },
    {
      "id": 6,
      "type": "piechart",
      "title": "리뷰 판정 비율",
      "description": "verdict=fresh(별 3.5개 이상)와 rotten 리뷰 수의 비율입니다.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 5,
        "x": 19,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${datasource}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "customMetrics\n| where $__timeFilter(timestamp)\n| where cloud_RoleName == \"$role\"\n| where name == \"movielog_reviews_posted\"\n| extend verdict = tostring(customDimensions.verdict)\n| where timestamp < bin(now(), max_of($__interval, 1m))\n| summarize reviews = sum(value) by verdict\n| order by verdict asc",
            "resources": [
              "$appinsights"
            ],
            "resultFormat": "table"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "pieType": "donut",
        "displayLabels": [
          "percent"
        ],
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "values": [
            "value"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "분당 영화 조회 (채널별 누적)",
      "description": "bin마다 증가량을 더한 뒤 분당 값으로 환산하고 채널을 쌓아 전체 처리량을 함께 봅니다.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${datasource}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "customMetrics\n| where $__timeFilter(timestamp)\n| where cloud_RoleName == \"$role\"\n| where name == \"movielog_movie_views\"\n| extend channel = tostring(customDimensions.channel)\n| where timestamp < bin(now(), max_of($__interval, 1m))\n| summarize perMin = sum(value) / (max_of($__interval, 1m) / 1m) by bin(timestamp, max_of($__interval, 1m)), channel\n| order by timestamp asc",
            "resources": [
              "$appinsights"
            ],
            "resultFormat": "time_series"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 35,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "displayName": "${__field.labels.channel}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "분당 새 리뷰 (fresh / rotten)",
      "description": "verdict dimension으로 나눈 리뷰 작성량입니다.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${datasource}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "customMetrics\n| where $__timeFilter(timestamp)\n| where cloud_RoleName == \"$role\"\n| where name == \"movielog_reviews_posted\"\n| extend verdict = tostring(customDimensions.verdict)\n| where timestamp < bin(now(), max_of($__interval, 1m))\n| summarize perMin = sum(value) / (max_of($__interval, 1m) / 1m) by bin(timestamp, max_of($__interval, 1m)), verdict\n| order by timestamp asc",
            "resources": [
              "$appinsights"
            ],
            "resultFormat": "time_series"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "lineWidth": 1
          },
          "displayName": "${__field.labels.verdict}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "활동별·채널별 합계",
      "description": "Counter 네 개의 구간 합계를 활동과 채널로 나눠 어느 경로가 많은지 비교합니다.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 11,
        "w": 9,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${datasource}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "customMetrics\n| where $__timeFilter(timestamp)\n| where cloud_RoleName == \"$role\"\n| where name in (\"movielog_movie_views\", \"movielog_review_views\", \"movielog_reviews_posted\", \"movielog_comments_posted\")\n| extend activity = case(name == \"movielog_movie_views\", \"영화 조회\",\n                         name == \"movielog_review_views\", \"리뷰 조회\",\n                         name == \"movielog_reviews_posted\", \"리뷰 작성\", \"댓글\")\n| extend series = strcat(activity, \" · \", tostring(customDimensions.channel))\n| where timestamp < bin(now(), max_of($__interval, 1m))\n| summarize total = sum(value) by series\n| order by total desc",
            "resources": [
              "$appinsights"
            ],
            "resultFormat": "table"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "continuous-BlPu"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "namePlacement": "top",
        "sizing": "manual",
        "minVizHeight": 32,
        "maxVizHeight": 32,
        "text": {
          "titleSize": 12,
          "valueSize": 14
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "평균 별점 추이",
      "description": "bin마다 sum(valueSum) / sum(valueCount)로 가중 평균을 계산합니다. 배경색은 평균 별점 gauge와 같은 기준입니다.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 11,
        "w": 15,
